---
import Sidereal from '../../layouts/Sidereal.astro';
import Manifest from '../../components/sidereal/Manifest.astro';
import { getCollection } from 'astro:content';
import '../../styles/sidereal/pages.css';

const studies = (await getCollection('work'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Sidereal title="Work" description="Deep dives on the AI-native products I've built — problem, approach, evals, and impact." mode="night">
  <section class="page">
    <div class="wrap">
      <header class="page__head rv">
        <a class="rule-link page__back" href="/">← Home</a>
        <p class="t-label">Selected work</p>
        <h1 class="page__title">Products &amp; agents I've shipped.</h1>
        <p class="t-dek">
          How I think about building AI-native products — the problem, the agent and
          eval design, the tradeoffs I made, and what moved.
        </p>
      </header>
      <Manifest studies={studies} headingLevel={2} />
    </div>
  </section>
</Sidereal>
