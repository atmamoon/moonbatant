---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const studies = (await getCollection('work'))
  .filter((s) => !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Case studies" description="Deep dives on the AI-native products I've built — problem, approach, evals, and impact.">
  <section style="padding-top: 64px;">
    <div class="container">
      <p class="section-label">Selected work</p>
      <h1 class="section-title" style="font-size: clamp(2rem,5vw,3rem);">Case studies</h1>
      <p class="muted" style="max-width: 640px; margin-bottom: 44px;">
        How I think about building AI-native products — the problem, the agent and
        eval design, the tradeoffs I made, and what moved.
      </p>

      <div class="cs-grid">
        {studies.map((s) => (
          <a class="card cs-card" href={`/work/${s.slug}`}>
            <div class="cs-card-top">
              <span class="chip">{s.data.company}</span>
              <span class="faint" style="font-size:0.82rem;">{s.data.timeline}</span>
            </div>
            <h3>{s.data.title}</h3>
            <p class="muted cs-card-summary">{s.data.summary}</p>
            {s.data.metrics.length > 0 && (
              <div class="cs-card-metrics">
                {s.data.metrics.slice(0, 3).map((m) => (
                  <div>
                    <div class="cs-card-metric-val">{m.value}</div>
                    <div class="faint cs-card-metric-label">{m.label}</div>
                  </div>
                ))}
              </div>
            )}
            <span class="cs-read">Read case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .cs-grid { display: flex; flex-direction: column; gap: 20px; }
  .cs-card { display: flex; flex-direction: column; gap: 12px; }
  .cs-card-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .cs-card h3 { font-size: 1.3rem; }
  .cs-card-summary { font-size: 1rem; }
  .cs-card-metrics {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    margin: 6px 0;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .cs-card-metric-val {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--accent-2);
  }
  .cs-card-metric-label { font-size: 0.78rem; }
  .cs-read { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: var(--accent); }
</style>
