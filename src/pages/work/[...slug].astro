---
import Sidereal from '../../layouts/Sidereal.astro';
import { getCollection } from 'astro:content';
import '../../styles/sidereal/pages.css';

export async function getStaticPaths() {
  const studies = (await getCollection('work')).filter((s) => !s.data.draft).sort((a, b) => a.data.order - b.data.order);
  return studies.map((study, i) => ({
    params: { slug: study.slug },
    props: { study, next: studies[(i + 1) % studies.length], index: i + 1, total: studies.length },
  }));
}

const { study, next, index, total } = Astro.props;
const { Content, headings } = await study.render();
const toc = headings.filter((h) => h.depth === 2);
const d = study.data;
const pad = (n: number) => String(n).padStart(2, '0');
const isNumeric = (v: string) => /\d/.test(v) && !/[a-wyzA-WYZ]/.test(v);
---

<Sidereal title={d.title} description={d.summary} mode="night">
  <article class="page case">
    <div class="wrap">
      <header class="page__head rv">
        <a class="rule-link page__back" href="/work">← All work</a>
        <p class="t-label">Case {pad(index)} / {pad(total)}</p>
        <h1 class="page__title">{d.title}</h1>
        <p class="t-dek">{d.summary}</p>
        <p class="case__meta t-label">
          <span>{d.company}</span><span class="sep" aria-hidden="true">·</span>
          <span>{d.role}</span><span class="sep" aria-hidden="true">·</span>
          <span>{d.timeline}</span>
        </p>
      </header>

      {d.metrics.length > 0 && (
        <div class="case__metrics rv" role="group" aria-label="Headline metrics">
          {d.metrics.map((m, i) => (
            <div class="case__metric">
              <span class:list={[isNumeric(m.value) ? 't-numeral' : 'case__val--word', 'case__val', i === 0 && 'case__val--lead', i === 0 && isNumeric(m.value) && 'numeral-live']}>{m.value}</span>
              <span class="case__cap">{m.label}</span>
            </div>
          ))}
        </div>
      )}

      <div class="case__grid">
        <div class="prose">   {/* long-form reading never fades in */}
          <Content />
        </div>
        <aside class="case__aside rv" aria-label="On this page">
          {toc.length > 0 && (
            <nav>
              <span class="t-label">Contents</span>
              <ol class="toc">
                {toc.map((h, i) => (<li><a href={`#${h.slug}`}><span class="toc__n">{pad(i + 1)}</span><span>{h.text}</span></a></li>))}
              </ol>
            </nav>
          )}
          {d.tags.length > 0 && (
            <div>
              <span class="t-label">Tags</span>
              <p class="case__tags">{d.tags.map((t, i) => (<><span>{t}</span>{i < d.tags.length - 1 && <span class="sep" aria-hidden="true">·</span>}</>))}</p>
            </div>
          )}
        </aside>
      </div>

      <footer class="case__foot rv">
        <div class="case__actions">
          <a class="rule-link" href="/work">← Back to all work</a>
          <a class="slate" href="/#contact">Let's talk <span aria-hidden="true">→</span></a>
        </div>
        <div class="case__next">
          <span class="t-label">Next case</span>
          <a href={`/work/${next.slug}`}>{next.data.title} →</a>
        </div>
      </footer>
    </div>
  </article>
  <script>
    // contents: mark the section being read, the last heading above a reading line 30% down the view
    const tocLinks = new Map([...document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]')].map((a) => [decodeURIComponent(a.getAttribute('href')!.slice(1)), a] as const));
    const headings = [...document.querySelectorAll<HTMLElement>('.prose > h2[id]')].filter((h) => tocLinks.has(h.id));
    if (headings.length && 'IntersectionObserver' in window) {
      let current = '';
      const update = () => {
        const line = window.innerHeight * 0.3;
        let id = headings[0].id;
        for (const h of headings) if (h.getBoundingClientRect().top <= line) id = h.id;
        if (id === current) return;
        current = id;
        tocLinks.forEach((a, key) => (key === id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
      };
      const io = new IntersectionObserver(update, { rootMargin: '0px 0px -70% 0px' });
      headings.forEach((h) => io.observe(h));
      update();
    }
  </script>
</Sidereal>
