---
import Sidereal from '../../layouts/Sidereal.astro';
import WritingList from '../../components/sidereal/WritingList.astro';
import { getCollection } from 'astro:content';
import { WRITING } from '../../consts';
import '../../styles/sidereal/pages.css';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const external = WRITING.filter((w) => w.href.startsWith('http'));
---

<Sidereal title="Writing" description="Essays and project write-ups — building AI-native products, agents, and tools." mode="night">
  <section class="page">
    <div class="wrap">
      <header class="page__head rv">
        <a class="rule-link page__back" href="/">← Home</a>
        <p class="t-label">Writing</p>
        <h1 class="page__title">Essays &amp; write-ups</h1>
      </header>
      <WritingList items={[
        ...posts.map((p) => ({ href: `/writing/${p.slug}/`, title: p.data.title, meta: p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }), summary: p.data.summary })),
        ...external.map((x) => ({ href: x.href, title: x.title, meta: x.outlet })),
      ]} />
    </div>
  </section>
</Sidereal>
