---
import Sidereal from '../../layouts/Sidereal.astro';
import { getCollection } from 'astro:content';
import { WRITING } from '../../consts';
import '../../styles/sidereal/pages.css';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const external = WRITING.filter((w) => w.href.startsWith('http'));
---

<Sidereal title="Writing" description="Essays and project write-ups — building AI-native products, agents, and tools." mode="night">
  <section class="page">
    <div class="wrap">
      <header class="page__head rv">
        <a class="rule-link page__back" href="/">← Home</a>
        <p class="t-label">Writing</p>
        <h1 class="page__title">Essays &amp; write-ups</h1>
      </header>
      <ul class="wlist">
        {posts.map((p) => (
          <li class="rv">
            <a href={`/writing/${p.slug}/`} class="wlist__row">
              <span class="wlist__title">{p.data.title}</span>
              <span class="t-label wlist__date">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <span class="wlist__summary">{p.data.summary}</span>
            </a>
          </li>
        ))}
        {external.map((w) => (
          <li class="rv">
            <a href={w.href} target="_blank" rel="noopener" class="wlist__row">
              <span class="wlist__title">{w.title}</span>
              <span class="t-label wlist__date">{w.outlet} ↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Sidereal>
