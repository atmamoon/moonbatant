---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import SectionLabel from '../../components/SectionLabel.astro';
import GlassCard from '../../components/GlassCard.astro';
import { WRITING } from '../../consts';

const posts = (await getCollection('writing'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// External pieces (Medium etc.) from consts — shown below the on-site posts.
const external = WRITING.filter((w) => w.href.startsWith('http'));
---

<Base title="Writing" description="Essays and project write-ups — building AI-native products, agents, and tools.">
  <div class="wlist-backdrop">
    <div class="wlist__body">
      <SectionLabel>Writing</SectionLabel>
      <h1 class="wlist__title">Essays &amp; write-ups</h1>
      <div class="wlist__items">
        {posts.map((p) => (
          <a href={`/writing/${p.slug}/`} class="wlist__item">
            <GlassCard padding="clamp(20px, 3vw, 30px)">
              <div class="wlist__date">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
              <h2 class="wlist__item-title">{p.data.title}</h2>
              <p class="wlist__summary">{p.data.summary}</p>
            </GlassCard>
          </a>
        ))}
        {external.map((w) => (
          <a href={w.href} target="_blank" rel="noopener" class="wlist__item">
            <GlassCard padding="clamp(20px, 3vw, 30px)">
              <div class="wlist__date">{w.outlet} ↗</div>
              <h2 class="wlist__item-title">{w.title}</h2>
            </GlassCard>
          </a>
        ))}
      </div>
    </div>
  </div>
</Base>

<style>
  .wlist-backdrop {
    position: relative; min-height: 70vh;
    background-image:
      linear-gradient(180deg, var(--atm-2) 0%, rgba(18,21,42,0.6) clamp(120px, 18vh, 240px), rgba(15,19,38,0.5) 70%, var(--atm-2) 100%),
      url('/photos/night-machapuchare.webp');
    background-size: cover, cover;
    background-position: center, center 38%;
    background-repeat: no-repeat, no-repeat;
  }
  .wlist__body {
    max-width: var(--maxw); margin: 0 auto;
    padding: clamp(32px, 5vw, 52px) var(--gutter) var(--section-y);
  }
  .wlist__title {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--text); margin: 14px 0 28px;
  }
  .wlist__items { display: grid; gap: 16px; max-width: 760px; }
  .wlist__item { text-decoration: none; display: block; }
  .wlist__item:hover :global(.glass-card) { border-color: var(--accent); }
  .wlist__date { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-soft); margin-bottom: 8px; }
  .wlist__item-title { font-family: var(--font-serif); font-size: 1.25rem; color: var(--text); margin: 0 0 6px; }
  .wlist__summary { color: var(--text-soft); font-size: 0.95rem; margin: 0; line-height: 1.5; }
</style>
