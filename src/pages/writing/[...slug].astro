---
import Sidereal from '../../layouts/Sidereal.astro';
import { getCollection } from 'astro:content';
import '../../styles/sidereal/pages.css';

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const dateStr = d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Sidereal title={d.title} description={d.summary} mode="night">
  <article class="page">
    <div class="wrap">
      <header class="page__head rv">
        <a class="rule-link page__back" href="/writing">← All writing</a>
        <p class="t-label">Writing <span class="sep" aria-hidden="true">·</span> {dateStr}</p>
        <h1 class="page__title">{d.title}</h1>
        <p class="t-dek">{d.summary}</p>
        {d.tags.length > 0 && (
          <p class="case__tags">{d.tags.map((t, i) => (<><span>{t}</span>{i < d.tags.length - 1 && <span class="sep" aria-hidden="true">·</span>}</>))}</p>
        )}
      </header>
      <div class="prose rv">
        <Content />
      </div>
      <footer class="case__foot rv">
        <a class="rule-link" href="/writing">← All writing</a>
        <a class="slate" href="/#contact">Let's talk <span aria-hidden="true">→</span></a>
      </footer>
    </div>
  </article>
</Sidereal>
