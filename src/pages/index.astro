---
import Base from '../layouts/Base.astro';
import Stage from '../components/Stage.astro';
import RopeHUD from '../components/RopeHUD.astro';
import HomeSections from '../components/HomeSections.astro';

// The traverse: one continuous light-arc, afternoon indigo → gold → cloud →
// twilight → astronomical night. Each plate is a vista; scroll walks between.
const PLATES = [
  {
    id: 'hero',
    photo: '/video/hero-amadablam-poster.webp',
    // slowed to cinemagraph pace — the summit should drift, not fly
    video: { av1: '/video/hero-amadablam.av1.mp4', h264: '/video/hero-amadablam.h264.mp4', rate: 0.55 },
  },
  { id: 'work', photo: '/photos/alpenglow-garhwal-ridge.webp', focal: '50% 72%', dim: 0.3 },
  { id: 'about', photo: '/photos/storm-annapurna.webp', dim: 0.14 },
  { id: 'experience', photo: '/photos/winterline-kangchenjunga.webp', dim: 0.18 },
  {
    id: 'writing',
    photo: '/video/night-stars-poster.webp',
    video: { av1: '/video/night-stars.av1.mp4', h264: '/video/night-stars.h264.mp4' },
  },
];
---

<Base>
  <Stage plates={PLATES} />
  <RopeHUD />
  <div class="journey-content">
    <HomeSections />
  </div>
  <a class="mode-toggle" href="/flight/" title="Fly the real range — 3D terrain from actual elevation data">
    <span class="mode-toggle__icon">◮</span> FLIGHT MODE
  </a>
</Base>

<style>
  .mode-toggle {
    position: fixed;
    right: clamp(14px, 2vw, 30px);
    bottom: 18px;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: var(--slate-300);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 8px 14px;
    background: rgba(10, 13, 26, 0.4);
    backdrop-filter: blur(8px);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .mode-toggle:hover { color: var(--glow-gold); border-color: var(--glow-gold); }
  .mode-toggle__icon { color: var(--glow-gold); font-size: 0.75rem; }
  @media (max-width: 900px) { .mode-toggle { display: none; } }
</style>
