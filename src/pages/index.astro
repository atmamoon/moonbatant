---
// Home — the Range Flythrough. The expedition content floating over a
// WebGL rendering of the REAL Nepal Himalaya: SRTM elevation displaced in a
// vertex shader, real Sentinel-2 imagery, camera flying Annapurna → Everest →
// Kangchenjunga as you scroll. Falls back to a still if WebGL2 is missing.
import Base from '../layouts/Base.astro';
import RopeHUD from '../components/RopeHUD.astro';
import HomeSections from '../components/HomeSections.astro';
---

<Base>
  <div class="terrain-stage" id="terrain-stage" aria-hidden="true">
    <div class="terrain-poster"></div>
    <div class="terrain-scrim"></div>
  </div>
  <div class="peak-labels" id="peak-labels" aria-hidden="true"></div>
  <RopeHUD />

  <div class="journey-content">
    <HomeSections />
    <p class="terrain-credit">
      Terrain: real SRTM elevation (Mapzen tiles) · Imagery: Sentinel-2 cloudless by EOX IT Services GmbH
      (contains modified Copernicus Sentinel data 2016) · Peaks placed at surveyed coordinates
    </p>
  </div>

</Base>

<script>
  import { initJourney } from '../scripts/journey';
  import { initTerrain } from '../scripts/terrain';
  initJourney();
  initTerrain();
</script>

<style is:global>
  .terrain-stage {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: linear-gradient(180deg, #1c1636 0%, #302447 46%, #131a30 100%);
  }
  .terrain-poster {
    position: absolute;
    inset: 0;
    background: url('/photos/alpenglow-everest.webp') center / cover no-repeat;
    opacity: 0.65;
  }
  .terrain-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .terrain-canvas.is-live { opacity: 1; }
  .no-terrain .terrain-canvas { display: none; }
  .terrain-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(6, 8, 18, 0.42) 0%, rgba(6, 8, 18, 0.05) 30%, rgba(6, 8, 18, 0.2) 68%, rgba(6, 8, 18, 0.72) 100%),
      linear-gradient(90deg, rgba(6, 8, 18, 0.3) 0%, rgba(6, 8, 18, 0) 45%);
  }

  .peak-labels {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .peak-label {
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--snow-200);
    opacity: 0;
    transition: opacity 0.6s ease;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.8);
    white-space: nowrap;
  }
  .peak-label::before {
    content: '▴';
    color: var(--glow-gold);
    margin-right: 6px;
  }

  .terrain-credit {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 var(--gutter) 26px;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--slate-400);
    opacity: 0.75;
  }

</style>
