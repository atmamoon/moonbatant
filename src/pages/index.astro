---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import {
  HERO,
  ABOUT,
  EXPERIENCE,
  EDUCATION,
  SKILLS,
  PROJECTS,
  SOCIALS,
} from '../consts';
import { EXTERNAL_WRITING } from '../data/external-writing';

// Featured case studies for the homepage
const caseStudies = (await getCollection('work'))
  .filter((s) => !s.data.draft && s.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

// Latest writing (local + external) for the homepage teaser
const localPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .map((p) => ({
    title: p.data.title,
    description: p.data.description,
    date: p.data.date,
    url: `/writing/${p.slug}`,
    source: 'moonbatant',
    external: false,
  }));

const external = EXTERNAL_WRITING.map((p) => ({
  title: p.title,
  description: p.description,
  date: new Date(p.date),
  url: p.url,
  source: p.source,
  external: true,
}));

const latest = [...localPosts, ...external]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---

<Base>
  <!-- ── Hero ───────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <p class="hero-kicker">{HERO.kicker}</p>
      <h1 class="hero-name">{HERO.name}</h1>
      <p class="hero-role">{HERO.role}</p>
      <p class="hero-tagline">{HERO.tagline}</p>
      <div class="hero-cta">
        <a href="#projects" class="btn btn-primary">View projects</a>
        <a href="/resume.pdf" target="_blank" rel="noopener" class="btn">Download résumé</a>
        <a href={`mailto:${SOCIALS.email}`} class="btn">Get in touch</a>
      </div>
      <div class="hero-meta faint">
        <span>📍 {SOCIALS.location}</span>
        <span>· Open to founding / senior PM roles in AI</span>
      </div>
    </div>
  </section>

  <!-- ── About ──────────────────────────────────────────────── -->
  <section id="about">
    <div class="container">
      <p class="section-label">About</p>
      <div class="about-grid">
        <div>
          {ABOUT.split('\n\n').map((para) => <p class="about-para">{para}</p>)}
        </div>
        <aside class="skills">
          {SKILLS.map((s) => (
            <div class="skill-group">
              <h4>{s.group}</h4>
              <div class="chips">
                {s.items.map((i) => <span class="chip">{i}</span>)}
              </div>
            </div>
          ))}
        </aside>
      </div>
    </div>
  </section>

  <!-- ── Experience ─────────────────────────────────────────── -->
  <section id="experience">
    <div class="container">
      <p class="section-label">Experience</p>
      <h2 class="section-title">Where I've shipped</h2>
      <div class="timeline">
        {EXPERIENCE.map((job) => (
          <article class="job">
            <div class="job-head">
              <div>
                <h3>{job.role} · <span class="job-co">{job.company}</span></h3>
                <p class="faint job-loc">{job.location}</p>
              </div>
              <span class="job-period chip">{job.period}</span>
            </div>
            <ul class="job-bullets">
              {job.highlights.map((h) => <li>{h}</li>)}
            </ul>
          </article>
        ))}
        <article class="job">
          <div class="job-head">
            <div>
              <h3>{EDUCATION.degree}</h3>
              <p class="faint job-loc">{EDUCATION.school}</p>
            </div>
            <span class="job-period chip">{EDUCATION.period}</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ── Case studies ───────────────────────────────────────── -->
  <section id="work">
    <div class="container">
      <p class="section-label">Selected work</p>
      <div class="writing-head">
        <h2 class="section-title" style="margin-bottom:0;">Case studies</h2>
        <a href="/work" class="btn">All case studies →</a>
      </div>
      <div class="cs-grid">
        {caseStudies.map((s) => (
          <a class="card cs-card" href={`/work/${s.slug}`}>
            <div class="cs-card-top">
              <span class="chip">{s.data.company}</span>
              <span class="faint" style="font-size:0.82rem;">{s.data.timeline}</span>
            </div>
            <h3>{s.data.title}</h3>
            <p class="muted cs-card-summary">{s.data.summary}</p>
            {s.data.metrics.length > 0 && (
              <div class="cs-card-metrics">
                {s.data.metrics.slice(0, 3).map((m) => (
                  <div>
                    <div class="cs-card-metric-val">{m.value}</div>
                    <div class="faint cs-card-metric-label">{m.label}</div>
                  </div>
                ))}
              </div>
            )}
            <span class="cs-read">Read case study →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Side builds ────────────────────────────────────────── -->
  <section id="projects">
    <div class="container">
      <p class="section-label">Building with Claude</p>
      <h2 class="section-title">Side builds &amp; experiments</h2>
      <div class="project-grid">
        {PROJECTS.map((p) => (
          <article class="card project">
            <h3>{p.title}</h3>
            <p class="muted project-blurb">{p.blurb}</p>
            <div class="chips">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
            {p.link && (
              <a class="project-link" href={p.link} target="_blank" rel="noopener">
                {p.linkLabel ?? 'Read more'} →
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Latest writing ─────────────────────────────────────── -->
  <section id="latest-writing">
    <div class="container">
      <p class="section-label">Writing & updates</p>
      <div class="writing-head">
        <h2 class="section-title" style="margin-bottom:0;">Latest from the lab</h2>
        <a href="/writing" class="btn">All writing →</a>
      </div>
      <div class="writing-list">
        {latest.map((post) => (
          <a
            class="writing-row"
            href={post.url}
            target={post.external ? '_blank' : undefined}
            rel={post.external ? 'noopener' : undefined}
          >
            <div>
              <h3 class="writing-title">{post.title}</h3>
              <p class="muted writing-desc">{post.description}</p>
            </div>
            <div class="writing-meta">
              <span class="chip">{post.source}</span>
              <span class="faint">{fmt(post.date)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Contact ────────────────────────────────────────────── -->
  <section id="contact">
    <div class="container contact">
      <p class="section-label" style="justify-content:center;">Contact</p>
      <h2 class="section-title">Let's build something.</h2>
      <p class="muted" style="max-width:560px; margin:0 auto 28px;">
        I'm open to founding and senior PM roles in AI, and always happy to swap
        notes on agent design, evals, and building with Claude.
      </p>
      <div class="hero-cta" style="justify-content:center;">
        <a href={`mailto:${SOCIALS.email}`} class="btn btn-primary">Email me</a>
        <a href={SOCIALS.linkedin} target="_blank" rel="noopener" class="btn">LinkedIn</a>
        <a href={SOCIALS.medium} target="_blank" rel="noopener" class="btn">Medium</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding: 96px 0 72px; }
  .hero-kicker {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    margin-bottom: 18px;
  }
  .hero-name {
    font-size: clamp(2.6rem, 7vw, 4.4rem);
    font-weight: 800;
    line-height: 1.02;
    background: linear-gradient(120deg, var(--text), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-role {
    font-size: clamp(1.1rem, 2.4vw, 1.5rem);
    color: var(--text);
    font-weight: 600;
    margin-top: 12px;
  }
  .hero-tagline {
    color: var(--text-soft);
    font-size: 1.1rem;
    max-width: 640px;
    margin-top: 18px;
  }
  .hero-cta {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .hero-meta {
    margin-top: 26px;
    font-size: 0.9rem;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  /* About */
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .about-para { font-size: 1.08rem; color: var(--text-soft); margin-bottom: 16px; }
  .skills { display: flex; flex-direction: column; gap: 20px; }
  .skill-group h4 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-faint);
    margin-bottom: 10px;
    font-family: var(--font-mono);
  }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; }

  /* Experience */
  .timeline { display: flex; flex-direction: column; gap: 18px; }
  .job {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 14px;
  }
  .job h3 { font-size: 1.15rem; }
  .job-co { color: var(--accent-2); }
  .job-loc { font-size: 0.85rem; margin-top: 4px; }
  .job-period { white-space: nowrap; }
  .job-bullets { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .job-bullets li {
    position: relative;
    padding-left: 20px;
    color: var(--text-soft);
    font-size: 0.98rem;
  }
  .job-bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Case studies */
  .cs-grid { display: flex; flex-direction: column; gap: 20px; }
  .cs-card { display: flex; flex-direction: column; gap: 12px; }
  .cs-card-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .cs-card h3 { font-size: 1.3rem; }
  .cs-card-summary { font-size: 1rem; }
  .cs-card-metrics {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    margin: 6px 0;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }
  .cs-card-metric-val { font-size: 1.25rem; font-weight: 800; color: var(--accent-2); }
  .cs-card-metric-label { font-size: 0.78rem; }
  .cs-read { font-family: var(--font-mono); font-size: 0.85rem; font-weight: 600; color: var(--accent); }

  /* Projects */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .project { display: flex; flex-direction: column; gap: 14px; }
  .project h3 { font-size: 1.18rem; }
  .project-blurb { font-size: 0.96rem; flex-grow: 1; }
  .project-link { font-weight: 600; font-family: var(--font-mono); font-size: 0.88rem; }

  /* Writing */
  .writing-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    gap: 16px;
  }
  .writing-list { display: flex; flex-direction: column; }
  .writing-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 22px 0;
    border-top: 1px solid var(--border);
    color: var(--text);
  }
  .writing-row:last-child { border-bottom: 1px solid var(--border); }
  .writing-row:hover .writing-title { color: var(--accent); }
  .writing-title { font-size: 1.12rem; transition: color 0.15s ease; }
  .writing-desc { font-size: 0.95rem; margin-top: 6px; max-width: 620px; }
  .writing-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    white-space: nowrap;
    font-size: 0.85rem;
  }

  /* Contact */
  .contact { text-align: center; }

  @media (max-width: 760px) {
    .about-grid { grid-template-columns: 1fr; gap: 30px; }
    .writing-row { flex-direction: column; align-items: flex-start; gap: 12px; }
    .writing-meta { flex-direction: row; align-items: center; }
  }
</style>
