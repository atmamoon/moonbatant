---
// Liquid-glass surface floating over a scene. Renders <a> if href is set.
// Emits the global `.glass` class (tokens/elevation.css owns the liquid recipe:
// gradient fill, specular rim, top-sheen bloom, deep blur). The `.glass` class
// is also what LiquidCursor keys off to show its refraction lens.
interface Props {
  hover?: boolean;
  padding?: string;
  href?: string;
  class?: string;
  style?: string;
}
const { hover = false, padding = '26px', href, class: cls, style = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
const extra = href ? { href } : {};
---
<Tag
  class:list={['glass', 'mb-glass', hover && 'mb-glass--hover', cls]}
  style={`padding:${padding};${style}`}
  {...extra}
>
  <slot />
</Tag>
<style>
  .mb-glass {
    display: block;
    color: var(--text);
  }
  a.mb-glass { text-decoration: none; }
  .mb-glass--hover {
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      border-color var(--dur) var(--ease), background var(--dur) var(--ease);
  }
  .mb-glass--hover:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 255, 255, 0.30);
    box-shadow:
      var(--shadow-lg),
      0 0 34px -10px var(--accent-glow),
      inset 0 1px 0 rgba(255, 255, 255, 0.42),
      inset 0 -1px 0 rgba(255, 255, 255, 0.09);
  }
  @media (prefers-reduced-motion: reduce) {
    .mb-glass--hover { transition: none; }
    .mb-glass--hover:hover { transform: none; }
  }
</style>
