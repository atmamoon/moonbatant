---
// Stage — the fixed WebGL world behind every Sidereal page. `mode`:
//   clock  — the home page; scroll advances the evening (chapters carry data-sun)
//   night  — reading pages; held at astronomical night with the moon up
interface Props { mode?: 'clock' | 'night' }
const { mode = 'clock' } = Astro.props;
---
<div class="stage" aria-hidden="true" data-mode={mode}>
  <div class="stage__poster"></div>
  <canvas id="sky" class="stage__sky"></canvas>
  <div class="stage__grad"></div>
  <div class="stage__rail"></div>
</div>

<script>
  import { initSidereal } from '../../scripts/sky';
  const stage = document.querySelector<HTMLElement>('.stage');
  initSidereal({ mode: (stage?.dataset.mode as 'clock' | 'night') || 'clock' });
</script>

<style is:global>
  .stage { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; background: var(--zenith); }
  .stage__sky { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity 0.9s ease; }
  /* until the range arrives the poster holds the frame; then the live sky crossfades in over it */
  html.webgl:not(.range-ready) .stage__sky { opacity: 0; }
  /* First paint / no WebGL: a still of the golden-hour frame (baked) under a sky gradient. */
  .stage__poster {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, #14306f 0%, #3b5a9c 42%, #c9b6a6 100%);
    opacity: 1;
    transition: opacity 0.9s ease, visibility 0s linear 0.9s;
  }
  .stage__poster::after {
    content: ''; position: absolute; inset: 0;
    background: url('/sidereal/poster.webp') center bottom / cover no-repeat;
  }
  .stage[data-mode='night'] .stage__poster { background: linear-gradient(180deg, #05070f 0%, #0b1226 60%, #131a33 100%); }
  .stage[data-mode='night'] .stage__poster::after { background-image: url('/sidereal/poster-night.webp'); }
  .range-ready .stage__poster { opacity: 0; visibility: hidden; }
  /* a third grad from the right edge, under the hero results and the manifest readouts, while the sky is
     bright; long and soft so it meets the left grad without leaving a light pillar between them */
  .stage__rail { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s ease;
    background: linear-gradient(270deg, rgba(5, 7, 15, 0.66) 0px, rgba(5, 7, 15, 0.5) 260px, rgba(5, 7, 15, 0.2) 520px, rgba(5, 7, 15, 0) 820px); }
  html[data-phase='golden'] .stage__rail, html[data-phase='sunset'] .stage__rail, html[data-phase='civil'] .stage__rail { opacity: 1; }
  html[data-phase='nautical'] .stage__rail { opacity: 0.5; }
  @media (max-width: 1099px) { .stage__rail { display: none; } }
  .no-webgl .stage__sky { display: none; }
  /* no WebGL, or a lost context: a night still on every page (the page switches to night ink) */
  .no-webgl .stage__poster { opacity: 1; visibility: visible; transition: opacity 0.6s ease; background: linear-gradient(180deg, #05070f 0%, #0b1226 60%, #131a33 100%); }
  .no-webgl .stage__poster::after { background-image: url('/sidereal/poster-night.webp'); }
  /* ND grad: a cinematographer's graduated filter over the lower frame. Static
     paint; only its opacity changes, per phase (compositor-only). */
  .stage__grad { position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s ease;
    background: linear-gradient(180deg, rgba(5, 7, 15, 0) 34%, rgba(5, 7, 15, 0.22) 58%, rgba(5, 7, 15, 0.46) 100%); }
  html[data-phase='sunset'] .stage__grad, html[data-phase='civil'] .stage__grad { opacity: 0.9; }
  html[data-phase='nautical'] .stage__grad, html[data-phase='astro'] .stage__grad { opacity: 0.6; }
  html[data-phase='night'] .stage__grad { opacity: 0.4; }
  /* a second grad, left-weighted: strongest where the text column lives, only while the sky is bright */
  .stage__grad::after { content: ''; position: absolute; inset: 0; opacity: 0; transition: opacity 1.2s ease;
    background: linear-gradient(100deg, rgba(6, 8, 20, 0.72) 0%, rgba(6, 8, 20, 0.5) 46%, rgba(6, 8, 20, 0.12) 82%, rgba(6, 8, 20, 0.12) 100%); }
  html[data-phase='golden'] .stage__grad, html[data-phase='golden'] .stage__grad::after { opacity: 1; }
  html[data-phase='golden'] .stage__grad { background: none; }
  html[data-phase='sunset'] .stage__grad::after, html[data-phase='civil'] .stage__grad::after { opacity: 0.85; }
  /* Phones: the text column is the full width, and the portrait crop puts the horizon glow behind
     the hero's lines where the left grad has faded out. A soft radial grad dims that glow; the left
     grad stays as it is, so this only ever adds shade. */
  @media (max-width: 1099px), (max-height: 500px) and (orientation: landscape) {
    .stage__grad::after {
      background: radial-gradient(90% 45% at 100% 58%, rgba(6, 8, 20, 0.55) 0%, rgba(6, 8, 20, 0.3) 55%, rgba(6, 8, 20, 0) 100%),
        linear-gradient(100deg, rgba(6, 8, 20, 0.72) 0%, rgba(6, 8, 20, 0.5) 46%, rgba(6, 8, 20, 0.12) 82%, rgba(6, 8, 20, 0.12) 100%);
    }
  }

</style>
