---
// HomeChapters: the seven chapters of the evening. Every string of content
// comes from src/consts.ts and the work collection, verbatim. Each chapter
// carries the solar altitude (data-sun) the stage lights it with. The scene is
// never annotated: no degrees, clock, coordinates, weather or place names are
// printed over it, so nothing competes with the content.
import { getCollection } from 'astro:content';
import { HERO, ABOUT, EXPERIENCE, EDUCATION, SKILLS, SOCIALS, WRITING } from '../../consts';
import Manifest from './Manifest.astro';

const featured = (await getCollection('work'))
  .filter((s) => !s.data.draft && s.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const bio = ABOUT.split('\n\n');
const pad = (n: number) => String(n).padStart(2, '0');
// solar altitude per chapter, in degrees: read by the stage, never shown
const CH = { work: -1, about: -5, experience: -10, education: -14, writing: -18, contact: -22 };
---

{/* 01 · the inscription */}
<section class="ch ch--hero" id="hero" data-chapter data-sun="4">
  <div class="wrap hero">
    <p class="t-label hero__kicker">{HERO.kicker}</p>
    <h1 class="t-inscription hero__name">{HERO.name}</h1>
    <p class="t-wide hero__role">{HERO.role}</p>
    <p class="t-dek hero__dek">{HERO.tagline}</p>
    <div class="hero__cta">
      <a class="slate slate--solid" href="#work">See selected work <span aria-hidden="true">↓</span></a>
      <a class="rule-link" href="/resume.pdf" target="_blank" rel="noopener">Résumé <span aria-hidden="true">↗</span></a>
    </div>
    <ol class="hero__instruments" aria-label="Headline results">
      {featured.map((s, i) => s.data.metrics[0] && (
        <li>
          <a href={`/work/${s.slug}`}>
            <span class="t-label hero__inst-idx">{pad(i + 1)}</span>
            <span class="t-label hero__inst-co">{s.data.company}</span>
            <span class="t-numeral hero__inst-val">{s.data.metrics[0].value}</span>
            <span class="hero__inst-cap">{s.data.metrics[0].label}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <div class="hero__hint" aria-hidden="true">
    <span class="hero__hint-line"></span>
  </div>
</section>

{/* 02 · selected work */}
<section class="ch" id="work" data-chapter data-sun={CH.work}>
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">02</span> Selected work</p>
      <h2 class="ch__title">Products &amp; agents I've shipped.</h2>
    </header>
    <Manifest studies={featured} />
  </div>
</section>

{/* 03 · about: one centred measure */}
<section class="ch ch--centre" id="about" data-chapter data-sun={CH.about}>
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">03</span> About</p>
      <h2 class="sr-only">About</h2>
    </header>
    <div class="about">
      <div class="about__bio rv">
        {bio.map((p, i) => <p class:list={['about__para', i === 0 && 'about__para--lead']}>{p}</p>)}
      </div>
      <h3 class="sr-only">Skills</h3>
      <dl class="credits rv">
        {SKILLS.map((g) => (
          <div class="credits__row">
            <dt class="t-label credits__group">{g.group}</dt>
            <dd class="credits__items">
              {g.items.map((it) => <span class="credits__item">{it}</span>)}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

{/* 04 · experience: the ledger */}
<section class="ch" id="experience" data-chapter data-sun={CH.experience}>
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">04</span> Experience</p>
      <h2 class="ch__title">Where I've shipped.</h2>
    </header>
    <div class="ledger">
      {EXPERIENCE.map((job, j) => (
        <article class="ledger__entry rv">
          <div class="ledger__head">
            <div>
              <h3 class="ledger__company">{job.company}</h3>
              <p class="ledger__role">{job.role}</p>
            </div>
            <div class="ledger__meta">
              <span class="t-label">{job.period}</span>
              <span class="t-label ledger__loc">{job.location}</span>
            </div>
          </div>
          <ul class="ledger__list">
            {job.highlights.map((h, i) => (
              <li><span class="ledger__n">{pad(j + 1)}.{pad(i + 1)}</span><span>{h}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

{/* 05 · education */}
<section class="ch ch--short" id="education" data-chapter data-sun={CH.education}>
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">05</span> Education</p>
      <h2 class="ch__title">{EDUCATION.school}</h2>
    </header>
    <div class="edu rv">
      <p class="edu__degree">{EDUCATION.degree}</p>
      <span class="t-label edu__period">{EDUCATION.period}</span>
    </div>
  </div>
</section>

{/* 06 · writing */}
<section class="ch" id="writing" data-chapter data-sun={CH.writing}>
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">06</span> Writing</p>
      <h2 class="ch__title">Essays &amp; write-ups</h2>
    </header>
    <ul class="wl">
      {WRITING.map((w, i) => (
        <li class="rv">
          <a class="wl__row" href={w.href} target={w.href.startsWith('http') ? '_blank' : undefined} rel={w.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="t-label wl__n">{pad(i + 1)}</span>
            <span class="wl__title">{w.title}</span>
            <span class="t-label wl__outlet">{w.outlet}</span>
            <span class="wl__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* 07 · contact: one sentence, the whole sky */}
<section class="ch ch--final" id="contact" data-chapter data-sun={CH.contact}>
  <div class="wrap final">
    <p class="t-label t-label--glow final__label rv">07 · Contact</p>
    <h2 class="final__title rv">Let's build something reliable.</h2>
    <p class="final__line rv">{SOCIALS.location} · <a href={`tel:${SOCIALS.phone.replace(/\s+/g, '')}`}>{SOCIALS.phone}</a></p>
    <div class="final__actions rv">
      <a class="slate slate--solid final__mail" href={`mailto:${SOCIALS.email}`}>{SOCIALS.email}</a>
      <div class="final__more">
        <a class="rule-link" href={SOCIALS.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
        <a class="rule-link" href={SOCIALS.medium} target="_blank" rel="noopener">Medium <span aria-hidden="true">↗</span></a>
        {SOCIALS.github && <a class="rule-link" href={SOCIALS.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </div>
  <div class="wrap">
    <footer class="colophon">
      <span class="t-label">© 2026 {HERO.name}</span>
      <a class="t-label colophon__top" href="#top">Back to the beginning ↑</a>
    </footer>
  </div>
</section>

<style>
  /* ── chapters ── */
  /* --ch-pad is the sky above a chapter's first line; the same amount as a negative scroll-margin
     lands in-page links on that first line, just under the header, instead of on empty sky */
  .ch { --ch-pad: var(--chapter-gap); position: relative; padding-top: var(--ch-pad); scroll-margin-top: calc(-1 * var(--ch-pad)); }
  .ch--short { --ch-pad: calc(var(--chapter-gap) * 0.55); }
  #writing { --ch-pad: calc(var(--chapter-gap) * 0.75); }
  .ch__head { display: grid; grid-template-columns: minmax(0, 1fr); align-items: baseline; gap: 22px 24px; margin-bottom: clamp(28px, 3.4vw, 44px); padding-bottom: 18px; border-bottom: 1px solid var(--rule); }
  .ch__head > .t-label:first-child { grid-column: 1; }
  .ch__title { grid-column: 1 / -1; max-width: 760px; font-size: var(--text-h2); line-height: 1.08; color: var(--ink); text-shadow: var(--ink-shadow); }
  .ch__head .t-label { color: var(--ink); text-shadow: var(--instrument-shadow); }   /* full ink: the handover between chapters can still be twilight-bright */
  .ch__idx { color: var(--ink); margin-right: 10px; }
  .ch__head .t-label::before { content: ''; display: inline-block; width: 28px; height: 1px; background: var(--rule-strong); vertical-align: middle; margin-right: 12px; }

  /* ── 01 hero: the inscription, two lines, left-weighted; the right two-thirds stay open ── */
  .ch--hero { --ch-pad: 0px; min-height: 100svh; display: flex; align-items: flex-start; padding-top: 0; }
  .hero { padding-top: clamp(140px, 21vh, 240px); padding-bottom: 20vh; position: relative; }
  /* the reserved right third carries the proof: one lead result per case, as instruments */
  .hero__instruments { list-style: none; position: absolute; right: var(--gutter); top: clamp(140px, 19vh, 230px); width: clamp(220px, 19vw, 300px); display: none; }
  @media (min-width: 1100px) { .hero__instruments { display: grid; } }   /* from the width where the right-edge grad behind it switches on */
  .hero__instruments li { border-top: 1px solid var(--rule); }
  .hero__instruments li:last-child { border-bottom: 1px solid var(--rule); }
  .hero__instruments a { display: grid; grid-template-columns: 28px minmax(0, 1fr); grid-template-rows: auto auto auto; column-gap: 12px; row-gap: 4px; padding: 14px 0; text-shadow: 0 0 2px rgba(5, 7, 15, 1), 0 0 8px rgba(5, 7, 15, 0.95), 0 0 20px rgba(5, 7, 15, 0.8); transition: color var(--dur) var(--ease); }
  .hero__instruments a:hover .hero__inst-val { color: var(--venus); }
  .hero__inst-idx { grid-row: 1 / span 3; color: var(--ink); padding-top: 0.5em; }
  .hero__inst-co { grid-column: 2; color: var(--ink); }   /* where the result was earned: each case's own company field */
  .hero__inst-val, .hero__inst-cap { grid-column: 2; }
  .hero__inst-val { font-size: clamp(1.6rem, 2.2vw, 2.1rem); color: var(--ink); transition: color var(--dur) var(--ease); }
  .hero__inst-cap { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink); line-height: 1.4; text-wrap: balance; }
  /* narrower screens: the four results sit beneath the actions as a two-by-two readout. After the base
     instrument rules on purpose: same specificity, so this must come later or the numbers overprint captions */
  @media (max-width: 1099px) {
    .hero__instruments { display: grid; position: static; width: auto; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 20px; margin-top: 32px; }
    .hero__instruments li:nth-last-child(-n + 2) { border-bottom: 1px solid var(--rule); }
    .hero__instruments a { grid-template-columns: minmax(0, 1fr); padding: 10px 0; }
    .hero__inst-idx { display: none; }
    .hero__inst-co, .hero__inst-val, .hero__inst-cap { grid-column: 1; }
  }
  .hero__kicker { margin-bottom: clamp(22px, 3vw, 34px); color: var(--alpenglow); }
  .hero__kicker::before { content: ''; display: inline-block; width: 28px; height: 1px; background: var(--alpenglow); vertical-align: middle; margin-right: 12px; }
  .hero__name { margin: 0 0 22px -0.04em; text-shadow: var(--ink-shadow); max-width: 11ch; }
  .hero__role { font-size: clamp(0.72rem, 1.1vw, 0.9rem); color: var(--ink-2); margin-bottom: clamp(28px, 4vw, 44px); text-shadow: var(--ink-shadow); }
  .hero__dek { max-width: 28em; margin-bottom: clamp(30px, 4vw, 44px); text-shadow: 0 1px 2px rgba(6, 8, 18, 0.7), 0 0 10px rgba(6, 8, 18, 0.6), 0 0 28px rgba(6, 8, 18, 0.55); color: var(--ink); hyphens: none; }
  .hero__cta { display: flex; align-items: baseline; gap: 32px; flex-wrap: wrap; }
  /* phones: one line from 375px, in the web font and its fallback alike, so the font's arrival never re-wraps the actions
     and shifts the page; narrower screens stack them on purpose */
  @media (max-width: 640px) { .hero__cta { flex-wrap: nowrap; column-gap: 18px; } .hero__cta .slate { padding-inline: 13px; letter-spacing: 0.12em; } }
  @media (max-width: 374px) { .hero__cta { flex-direction: column; align-items: flex-start; row-gap: 22px; } }
  .hero__hint { position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; pointer-events: none; }
  .hero__hint-line { width: 1px; height: 44px; background: linear-gradient(180deg, transparent, var(--ink-2)); animation: hint 3.2s var(--ease) 4 both; transform-origin: top; }   /* four passes, then still: no endless style work */
  @keyframes hint { 0% { transform: scaleY(0); opacity: 0; } 35% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

  /* ── 03 about: one centred measure; credits beneath ── */
  .ch--centre .ch__head { max-width: 720px; margin-inline: auto; }
  .about { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; row-gap: clamp(48px, 7vw, 88px); }
  .about > * { width: 100%; max-width: 720px; min-width: 0; }   /* px, not ch: `ch` resolves against the wrong size in a serif */
  .about__para { font-family: var(--font-serif); font-size: 1.16rem; line-height: 1.6; color: var(--ink-2); margin: 0 0 1.1em; text-shadow: var(--ink-shadow); }
  .about__para--lead { font-size: clamp(1.32rem, 1.9vw, 1.66rem); line-height: 1.38; color: var(--ink); }
  .credits { display: grid; grid-template-columns: minmax(0, 1fr); }
  .credits__row { display: grid; grid-template-columns: 148px minmax(0, 1fr); column-gap: 24px; padding: 16px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .credits__row:last-child { border-bottom: 1px solid var(--rule); }
  .credits__group { text-align: right; color: var(--alpenglow); justify-content: flex-end; }
  .credits__items { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0; row-gap: 4px; margin-left: -1.2em; clip-path: inset(-40px -40px -40px 1.2em); font-family: var(--font-display); font-size: var(--text-ui); line-height: 1.5; color: var(--ink); text-shadow: var(--ink-shadow); }
  .credits__item { white-space: nowrap; position: relative; padding-left: 1.2em; }
  .credits__item::before { content: '·'; position: absolute; left: 0.45em; color: var(--ink-4); }

  /* ── 04 ledger ── */
  .ledger { display: grid; }
  .ledger__entry { padding: 34px 0 40px; border-top: 1px solid var(--rule); }
  .ledger__entry:first-child { border-top: 0; }
  .ledger__entry:last-child { border-bottom: 1px solid var(--rule); }
  .ledger__head { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; margin-bottom: 26px; max-width: 74ch; }   /* dates beside the highlights, not stranded at the far edge */
  .ledger__company { font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1; color: var(--ink); text-shadow: var(--ink-shadow); }
  .ledger__role { font-family: var(--font-display); font-size: var(--text-ui); color: var(--ink-2); margin-top: 8px; }
  .ledger__meta { display: grid; justify-items: end; gap: 6px; text-align: right; white-space: nowrap; padding-top: 6px; }
  .ledger__meta .t-label { color: var(--ink-2); }
  .ledger__loc { color: var(--ink-2) !important; }
  .ledger__list { list-style: none; display: grid; gap: 14px; max-width: 74ch; }
  .ledger__list li { display: grid; grid-template-columns: 58px minmax(0, 1fr); column-gap: 14px; font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.55; color: var(--ink); }
  .ledger__n { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; color: var(--ink-2); padding-top: 0.45em; font-variant-numeric: tabular-nums; text-shadow: var(--instrument-shadow); }

  /* ── 05 education ── */
  .edu { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; flex-wrap: wrap; padding-bottom: 28px; border-bottom: 1px solid var(--rule); max-width: 760px; }
  .edu__degree { font-family: var(--font-display); font-size: var(--text-ui); color: var(--ink-2); }
  .edu__period { color: var(--ink-2); }

  /* ── 06 writing ── */
  .wl { list-style: none; display: grid; max-width: 960px; }
  #writing .ch__head { max-width: 960px; }   /* the writing measure: each outlet sits near its title, not across the sky */
  #education .ch__head { max-width: 760px; }   /* the heading's rule ends where the degree row's does */
  .wl li:first-child .wl__row { border-top: 0; }
  .wl__row { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto 24px; align-items: start; column-gap: 18px; padding: 22px 0; border-top: 1px solid var(--rule); transition: border-color var(--dur) var(--ease); }
  .wl li:last-child .wl__row { border-bottom: 1px solid var(--rule); }
  .wl__n { color: var(--ink-2); padding-top: 0.42em; }
  .wl__outlet, .wl__arrow { padding-top: 0.3em; }
  .wl__title { font-family: var(--font-serif); font-size: clamp(1.15rem, 1.8vw, 1.5rem); line-height: 1.25; color: var(--ink); transition: color var(--dur) var(--ease); }
  .wl__outlet { color: var(--ink-2); }
  .wl__arrow { color: var(--ink-3); justify-self: end; transition: transform var(--dur) var(--ease), color var(--dur) var(--ease); }
  .wl__row:hover { border-color: var(--rule-glow); }
  .wl__row:hover .wl__title { color: var(--venus); }
  .wl__row:hover .wl__arrow { color: var(--alpenglow); transform: translate(3px, -3px); }

  /* ── 07 moonrise: one sentence, the whole sky. The moon rises behind the
        highest summit and hangs above the line; the text waits below it. ── */
  .ch--final { min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding-top: calc(var(--chapter-gap) * 0.8); padding-bottom: 28px; scroll-margin-top: 0; }
  .final { display: grid; justify-items: center; text-align: center; gap: 18px; margin-bottom: clamp(60px, 10vh, 120px); }

  .final__title { font-size: clamp(2.2rem, 4.6vw, 3.8rem); line-height: 1.05; color: var(--ink); text-shadow: var(--ink-shadow); max-width: 14ch; }
  .final__line { font-family: var(--font-display); font-size: var(--text-ui); color: var(--ink-2); }
  .final__line a { border-bottom: 1px solid var(--rule-strong); padding-bottom: 2px; }
  .final__line a:hover { color: var(--venus); border-color: var(--rule-glow); }
  .final__actions { display: grid; justify-items: center; gap: 22px; margin-top: 14px; max-width: 100%; }
  .final__mail { min-height: 48px; font-size: clamp(0.8125rem, 4.1vw, 0.9375rem); padding-inline: clamp(10px, 5vw, 20px); letter-spacing: 0.02em; text-transform: none; font-stretch: 100%; font-weight: 500; background: #d6dae3; border-color: #d6dae3; color: #0b0f1c; white-space: normal; overflow-wrap: anywhere; max-width: 100%; text-align: center; }
  .final__mail:hover { background: var(--ink); color: #0b0f1c; border-color: var(--ink); }
  .final__more { display: flex; flex-wrap: wrap; justify-content: center; column-gap: clamp(14px, 5vw, 24px); row-gap: 12px; }
  .final__more .rule-link { color: var(--ink-2); }
  .colophon { padding-top: 22px; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; }
  .colophon .t-label { color: var(--ink-4); }
  .colophon__top { color: var(--ink-3) !important; }
  .colophon__top:hover { color: var(--venus) !important; }

  @media (max-width: 900px) {
    .credits__row { grid-template-columns: 116px minmax(0, 1fr); }
    .credits__group { text-align: left; justify-content: flex-start; }
  }
  @media (max-width: 640px) {
    .ch { --ch-pad: var(--chapter-gap-mobile); padding-top: var(--ch-pad); }
    .ch--hero { --ch-pad: 0px; padding-top: 0; }   /* the phone chapter gap must not stack on the hero's own top padding */
    .hero { padding-top: 132px; }
    .ch--short { --ch-pad: calc(var(--chapter-gap-mobile) * 0.7); }
    .ch__head { grid-template-columns: 1fr; gap: 10px; margin-bottom: 26px; }
    .ledger__head { flex-direction: column; gap: 12px; }
    .ledger__meta { justify-items: start; text-align: left; }
    .ledger__list li { grid-template-columns: 1fr; font-size: 1.02rem; }
    .ledger__n { padding-top: 0; }   /* on phones the index sits above each highlight as its leader */
    .about__para { font-size: 1.05rem; }
    .about__para--lead { font-size: 1.2rem; line-height: 1.45; }
    .wl__row { grid-template-columns: 28px minmax(0, 1fr) auto; }
    .wl__outlet { grid-row: 2; grid-column: 2; }
    .wl__arrow { grid-row: 1 / span 2; grid-column: 3; }
    .hero__hint { display: none; }
    .credits__row { grid-template-columns: minmax(0, 1fr); row-gap: 8px; }
    .credits__item { white-space: normal; }   /* a long skill wraps inside the column on narrow phones */
  }
  @media (prefers-reduced-motion: reduce) { .hero__hint-line { animation: none; } }
</style>
