---
// HomeChapters — the six chapters of the evening. Every string of content
// comes from src/consts.ts and the work collection, verbatim. Each chapter is
// pinned to a real solar altitude (data-sun) that the stage reads.
import { getCollection } from 'astro:content';
import { HERO, ABOUT, EXPERIENCE, EDUCATION, SKILLS, SOCIALS, WRITING } from '../../consts';
import Manifest from './Manifest.astro';
import { clockOf, sunLabel } from '../../scripts/twilight';

const featured = (await getCollection('work'))
  .filter((s) => !s.data.draft && s.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const bio = ABOUT.split('\n\n');
const pad = (n: number) => String(n).padStart(2, '0');
// the burn-in per chapter: local time + solar altitude (see scripts/twilight.ts)
const clock = clockOf;
const CH = { work: -1, about: -5, experience: -10, education: -15, writing: -20 };
---

<!-- 01 · GOLDEN HOUR — the inscription -->
<section class="ch ch--hero" id="hero" data-chapter data-sun="4" data-chapter-label="Golden hour">
  <div class="wrap hero">
    <p class="t-label hero__kicker rv">{HERO.kicker}</p>
    <h1 class="t-inscription hero__name rv">{HERO.name}</h1>
    <p class="t-wide hero__role rv">{HERO.role}</p>
    <p class="t-dek hero__dek rv">{HERO.tagline}</p>
    <div class="hero__cta rv">
      <a class="slate" href="#work">See selected work <span aria-hidden="true">↓</span></a>
      <a class="rule-link" href="/resume.pdf" target="_blank" rel="noopener">Résumé <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="hero__hint" aria-hidden="true">
    <span class="hero__hint-line"></span>
    <span class="hero__hint-text">The evening begins</span>
  </div>
</section>

<!-- 02 · SUNSET — the manifest -->
<section class="ch" id="work" data-chapter data-sun="-1" data-chapter-label="Sunset">
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">02</span> Selected work</p>
      <span class="ch__time t-label" aria-hidden="true">{clock(CH.work)} NPT <span class="ch__time-sep">·</span> Sun {sunLabel(CH.work)} <span class="ch__time-sep">·</span> Sunset</span>
      <h2 class="ch__title">Products &amp; agents I've shipped.</h2>
    </header>
    <Manifest studies={featured} />
  </div>
</section>

<!-- 03 · CIVIL TWILIGHT — about + the credits -->
<section class="ch" id="about" data-chapter data-sun="-5" data-chapter-label="Civil twilight">
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">03</span> About</p>
      <span class="ch__time t-label" aria-hidden="true">{clock(CH.about)} NPT <span class="ch__time-sep">·</span> Sun {sunLabel(CH.about)} <span class="ch__time-sep">·</span> Civil twilight</span>
    </header>
    <div class="about">
      <div class="about__bio rv">
        {bio.map((p, i) => <p class:list={['about__para', i === 0 && 'about__para--lead']}>{p}</p>)}
      </div>
      <dl class="credits rv" aria-label="Skills">
        {SKILLS.map((g) => (
          <div class="credits__row">
            <dt class="t-label credits__group">{g.group}</dt>
            <dd class="credits__items">
              {g.items.map((it, i) => (<><span class="credits__item">{it}</span>{i < g.items.length - 1 && <span class="credits__dot" aria-hidden="true">·</span>}</>))}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<!-- 04 · NAUTICAL TWILIGHT — the ledger -->
<section class="ch" id="experience" data-chapter data-sun="-10" data-chapter-label="Nautical twilight">
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">04</span> Experience</p>
      <span class="ch__time t-label" aria-hidden="true">{clock(CH.experience)} NPT <span class="ch__time-sep">·</span> Sun {sunLabel(CH.experience)} <span class="ch__time-sep">·</span> Nautical twilight</span>
      <h2 class="ch__title">Where I've shipped.</h2>
    </header>
    <div class="ledger">
      {EXPERIENCE.map((job, j) => (
        <article class="ledger__entry rv">
          <div class="ledger__head">
            <div>
              <h3 class="ledger__company">{job.company}</h3>
              <p class="ledger__role">{job.role}</p>
            </div>
            <div class="ledger__meta">
              <span class="t-label">{job.period}</span>
              <span class="t-label ledger__loc">{job.location}</span>
            </div>
          </div>
          <ul class="ledger__list">
            {job.highlights.map((h, i) => (
              <li><span class="ledger__n">{pad(j + 1)}.{pad(i + 1)}</span><span>{h}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 05 · ASTRONOMICAL TWILIGHT — education -->
<section class="ch ch--short" id="education" data-chapter data-sun="-15" data-chapter-label="Astronomical twilight">
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">05</span> Education</p>
      <span class="ch__time t-label" aria-hidden="true">{clock(CH.education)} NPT <span class="ch__time-sep">·</span> Sun {sunLabel(CH.education)} <span class="ch__time-sep">·</span> Astronomical twilight</span>
    </header>
    <div class="ledger">
      <article class="ledger__entry rv">
        <div class="ledger__head">
          <div>
            <h3 class="ledger__company">{EDUCATION.school}</h3>
            <p class="ledger__role">{EDUCATION.degree}</p>
          </div>
          <div class="ledger__meta"><span class="t-label">{EDUCATION.period}</span></div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- 06 · NIGHT — writing + the note left at the camp -->
<section class="ch ch--night" id="writing" data-chapter data-sun="-20" data-chapter-label="Night">
  <div class="wrap">
    <header class="ch__head rv">
      <p class="t-label"><span class="ch__idx">06</span> Writing</p>
      <span class="ch__time t-label" aria-hidden="true">{clock(CH.writing)} NPT <span class="ch__time-sep">·</span> Sun {sunLabel(CH.writing)} <span class="ch__time-sep">·</span> Night</span>
    </header>
    <ul class="wl">
      {WRITING.map((w, i) => (
        <li class="rv">
          <a class="wl__row" href={w.href} target={w.href.startsWith('http') ? '_blank' : undefined} rel={w.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="t-label wl__n">{pad(i + 1)}</span>
            <span class="wl__title">{w.title}</span>
            <span class="t-label wl__outlet">{w.outlet}</span>
            <span class="wl__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="contact rv" id="contact">
      <p class="t-label t-label--glow">Contact</p>
      <h2 class="contact__title">Let's build something reliable.</h2>
      <p class="contact__line">{SOCIALS.location} · {SOCIALS.phone}</p>
      <div class="contact__actions">
        <a class="rule-link" href={`mailto:${SOCIALS.email}`}>Email</a>
        <a class="rule-link" href={SOCIALS.linkedin} target="_blank" rel="noopener">LinkedIn <span aria-hidden="true">↗</span></a>
        <a class="rule-link" href={SOCIALS.medium} target="_blank" rel="noopener">Medium <span aria-hidden="true">↗</span></a>
        {SOCIALS.github && <a class="rule-link" href={SOCIALS.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>}
      </div>
    </div>

    <footer class="colophon">
      <span class="t-label">© 2026 {HERO.name}</span>
      <span class="t-label colophon__mid">Stars: Hipparcos via d3-celestial · Twilight computed for 27.99°N</span>
      <a class="t-label colophon__top" href="#top">Back to the beginning ↑</a>
    </footer>
  </div>
</section>

<style>
  /* ── chapters ── */
  .ch { position: relative; padding-top: var(--chapter-gap); }
  .ch--short { padding-top: calc(var(--chapter-gap) * 0.55); }
  .ch__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 22px 24px; margin-bottom: clamp(36px, 5vw, 56px); padding-bottom: 18px; border-bottom: 1px solid var(--rule); }
  .ch__head > .t-label:first-child { grid-column: 1; }
  .ch__time { grid-column: 2; justify-self: end; color: var(--ink-4); font-variant-numeric: tabular-nums; text-align: right; }
  .ch__time-sep { color: var(--ink-4); margin: 0 4px; }
  .ch__title { grid-column: 1 / -1; max-width: 760px; }
  .ch__idx { color: var(--ink-4); margin-right: 10px; }
  .ch__title { font-size: var(--text-h2); line-height: 1.08; color: var(--ink); text-shadow: var(--ink-shadow); }
  .t-label { display: inline-flex; align-items: center; gap: 12px; }
  .ch__head .t-label::before { content: ''; width: 28px; height: 1px; background: var(--rule-strong); }

  /* ── 01 hero ── */
  .ch--hero { min-height: 100svh; display: flex; align-items: flex-start; padding-top: 0; }
  .hero { padding-top: clamp(120px, 19vh, 220px); padding-bottom: 20vh; }
  .hero__kicker { margin-bottom: clamp(22px, 3vw, 34px); color: var(--alpenglow); }
  .hero__kicker::before { content: ''; width: 28px; height: 1px; background: var(--alpenglow); }
  .hero__name { margin: 0 0 18px -0.04em; text-shadow: var(--ink-shadow); white-space: nowrap; }
  .hero__role { font-size: clamp(0.72rem, 1.1vw, 0.9rem); color: var(--ink-2); margin-bottom: clamp(28px, 4vw, 44px); text-shadow: var(--ink-shadow); }
  .hero__dek { max-width: 40em; margin-bottom: clamp(30px, 4vw, 44px); text-shadow: var(--ink-shadow); color: var(--ink); }
  .hero__cta { display: flex; align-items: baseline; gap: 32px; flex-wrap: wrap; }
  .hero__hint { position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 10px; pointer-events: none; }
  .hero__hint-line { width: 1px; height: 44px; background: linear-gradient(180deg, transparent, var(--ink-2)); animation: hint 3.2s var(--ease) infinite; transform-origin: top; }
  .hero__hint-text { font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink-3); }
  @keyframes hint { 0% { transform: scaleY(0); opacity: 0; } 35% { transform: scaleY(1); opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

  /* ── 03 about + credits ── */
  .about { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 6vw, 96px); row-gap: 48px; align-items: start; }
  .about__para { font-family: var(--font-serif); font-size: 1.14rem; line-height: 1.6; color: var(--ink-2); margin: 0 0 1.1em; max-width: 60ch; text-shadow: var(--ink-shadow); }
  .about__para--lead { font-size: clamp(1.3rem, 1.9vw, 1.62rem); line-height: 1.38; color: var(--ink); }
  .credits { display: grid; gap: 0; }
  .credits__row { display: grid; grid-template-columns: 112px minmax(0, 1fr); column-gap: 18px; padding: 16px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .credits__row:last-child { border-bottom: 1px solid var(--rule); }
  .credits__group { text-align: right; color: var(--alpenglow); justify-content: flex-end; }
  .credits__items { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 8px; row-gap: 4px; font-family: var(--font-display); font-size: var(--text-ui); line-height: 1.5; color: var(--ink-2); }
  .credits__item { white-space: nowrap; }
  .credits__dot { color: var(--ink-4); }

  /* ── 04 ledger ── */
  .ledger { display: grid; }
  .ledger__entry { padding: 34px 0 40px; border-top: 1px solid var(--rule); }
  .ledger__entry:last-child { border-bottom: 1px solid var(--rule); }
  .ledger__head { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; margin-bottom: 26px; }
  .ledger__company { font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1; color: var(--ink); text-shadow: var(--ink-shadow); }
  .ledger__role { font-family: var(--font-display); font-size: var(--text-ui); color: var(--ink-2); margin-top: 8px; }
  .ledger__meta { display: grid; justify-items: end; gap: 6px; text-align: right; white-space: nowrap; padding-top: 6px; }
  .ledger__meta .t-label { color: var(--ink-2); }
  .ledger__loc { color: var(--ink-4) !important; }
  .ledger__list { list-style: none; display: grid; gap: 14px; max-width: 74ch; }
  .ledger__list li { display: grid; grid-template-columns: 58px minmax(0, 1fr); column-gap: 14px; font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.55; color: var(--ink-2); }
  .ledger__n { font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.1em; color: var(--ink-4); padding-top: 0.5em; font-variant-numeric: tabular-nums; }

  /* ── 06 writing + contact ── */
  .ch--night { padding-bottom: 120px; }
  .ch--night .ch__head, .wl, .contact, .colophon { max-width: 960px; }
  .wl { list-style: none; display: grid; }
  .wl__row { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto 24px; align-items: center; column-gap: 18px; padding: 22px 0; border-top: 1px solid var(--rule); transition: border-color var(--dur) var(--ease); }
  .wl li:last-child .wl__row { border-bottom: 1px solid var(--rule); }
  .wl__n { color: var(--ink-4); }
  .wl__title { font-family: var(--font-serif); font-size: clamp(1.15rem, 1.8vw, 1.5rem); line-height: 1.25; color: var(--ink); transition: color var(--dur) var(--ease); }
  .wl__outlet { color: var(--ink-3); }
  .wl__arrow { color: var(--ink-3); justify-self: end; transition: transform var(--dur) var(--ease), color var(--dur) var(--ease); }
  .wl__row:hover { border-color: var(--rule-glow); }
  .wl__row:hover .wl__title { color: var(--venus); }
  .wl__row:hover .wl__arrow { color: var(--alpenglow); transform: translate(3px, -3px); }

  .contact { margin-top: clamp(96px, 16vh, 160px); display: grid; gap: 18px; max-width: 760px; }
  .contact__title { font-size: clamp(2rem, 4.2vw, 3.4rem); line-height: 1.05; color: var(--ink); text-shadow: var(--ink-shadow); }
  .contact__line { font-family: var(--font-display); font-size: var(--text-ui); color: var(--ink-2); }
  .contact__actions { display: flex; flex-wrap: wrap; gap: 26px; margin-top: 10px; }

  .colophon { margin-top: clamp(80px, 12vh, 140px); padding-top: 22px; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; align-items: center; gap: 18px; flex-wrap: wrap; }
  .colophon .t-label { color: var(--ink-4); }
  .colophon__top { color: var(--ink-3) !important; }
  .colophon__top:hover { color: var(--venus) !important; }

  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; }
    .credits__row { grid-template-columns: 84px 1fr; }
    .credits__group { text-align: left; justify-content: flex-start; }
    .hero__name { white-space: normal; }
  }
  @media (max-width: 640px) {
    .ch__head { grid-template-columns: 1fr; }
    .ch__time { grid-column: 1; justify-self: start; text-align: left; }
    .ledger__head { flex-direction: column; gap: 12px; }
    .ledger__meta { justify-items: start; text-align: left; }
    .ledger__list li { grid-template-columns: 1fr; }
    .ledger__n { display: none; }
    .wl__row { grid-template-columns: 1fr auto; }
    .wl__n { display: none; }
    .wl__outlet { grid-row: 2; grid-column: 1; }
    .wl__arrow { grid-row: 1 / span 2; }
    .hero__hint { display: none; }
    .colophon__mid { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__hint-line { animation: none; } }
</style>
