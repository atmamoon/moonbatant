---
import Mark from '../Mark.astro';
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];
// on the home page chapter links are plain fragments, Work's too (its chapter holds the same rows): the engine eases them, and a query string
// in the address (a tagged share link) can't turn a click into a full reload
const onHome = Astro.url.pathname === '/';
const link = (href: string) => (onHome && href === '/work' ? '#work' : onHome && href.startsWith('/#') ? href.slice(1) : href);
// the nav marks where the reader is: the page itself, or the section a case study belongs to
const here = Astro.url.pathname.length > 1 && Astro.url.pathname.endsWith('/') ? Astro.url.pathname.slice(0, -1) : Astro.url.pathname;
const current = (href: string) => {
  if (href === '/#writing' && (here === '/writing' || here.startsWith('/writing/'))) return 'true';   // the link goes to the home chapter: /writing is its section, not its page
  return href.includes('#') ? undefined : here === href ? 'page' : here.startsWith(href + '/') ? 'true' : undefined;
};
---
<header class="hd">
  <div class="hd__inner">
    <a href="/" class="hd__brand" aria-label="moonbatant — home">
      <Mark size={22} />
      <span class="hd__word">moonbatant</span>
    </a>
    <nav class="hd__nav" aria-label="Primary">
      {nav.map((n) => <a href={link(n.href)} aria-current={current(n.href)}>{n.label}</a>)}
      <a href="/resume.pdf" target="_blank" rel="noopener" class="hd__cv">Résumé <span aria-hidden="true">↗</span></a>
    </nav>
    <button id="menu-btn" class="hd__menu" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span>
    </button>
  </div>
  <nav id="mobile-nav" class="hd__mobile" aria-label="Mobile">
    {nav.map((n) => <a href={link(n.href)} aria-current={current(n.href)}>{n.label}</a>)}
    <a href="/resume.pdf" target="_blank" rel="noopener">Résumé <span aria-hidden="true">↗</span></a>
  </nav>
</header>

<style>
  .hd { --band: 5 7 15; position: fixed; top: 0; left: 0; right: 0; z-index: 50; pointer-events: none; }
  /* the band takes a darker shade of the sky's own colour while the sky is bright, so it reads as dusk overhead,
     not a toolbar; a discrete change per phase, like the ink, and always opaque where the nav sits */
  :global(html[data-phase='golden']) .hd, :global(html[data-phase='sunset']) .hd { --band: 16 26 60; }
  :global(html[data-phase='civil']) .hd { --band: 12 18 42; }
  :global(html[data-phase='nautical']) .hd { --band: 9 14 31; }
  /* a quiet top scrim so scrolled text never collides with the nav (static paint, fixed) */
  .hd::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 132px; background: linear-gradient(180deg, rgb(var(--band)) 0%, rgb(var(--band)) 50%, rgb(var(--band) / 0.55) 72%, rgb(var(--band) / 0) 100%); pointer-events: none; }
  /* the band's opaque top hides what scrolls beneath it, so it takes those clicks too (the nav sits above and stays clickable) */
  .hd::after { content: ''; position: absolute; inset: 0 0 auto 0; height: 66px; pointer-events: auto; }
  .hd__inner {
    position: relative; z-index: 1;   /* above the title-safe scrim (an absolutely positioned ::before) */
    pointer-events: auto;
    max-width: var(--maxw); margin: 0 auto;
    padding: 22px var(--gutter-r) 0 var(--gutter-l);
    display: flex; align-items: center; gap: 24px;
  }
  .hd__brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-shadow: var(--ink-shadow); }
  .hd__brand :global(.mb-mark) { color: var(--alpenglow); }
  .hd__word {
    font-family: var(--font-display); font-stretch: 118%; font-weight: 500;
    font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase;
  }
  .hd__nav { margin-left: auto; display: flex; align-items: center; gap: 26px; }
  .hd__nav a {
    font-family: var(--font-mono); font-size: var(--text-label); letter-spacing: var(--track-label); text-transform: uppercase;
    color: var(--ink-2); text-shadow: var(--ink-shadow); padding-bottom: 4px; border-bottom: 1px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .hd__nav a:hover { color: var(--venus); border-color: var(--rule-glow); }
  .hd__nav a[aria-current] { color: var(--ink); border-color: var(--rule-strong); }   /* where the reader is */
  .hd__cv { color: var(--ink) !important; }
  .hd__menu { display: none; margin-left: auto; width: 40px; height: 40px; flex-direction: column; align-items: center; justify-content: center; gap: 6px; pointer-events: auto; }
  .hd__menu span { display: block; width: 22px; height: 1px; background: var(--ink); transition: transform var(--dur) var(--ease); }
  .hd__menu[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .hd__menu[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .hd__mobile {
    position: relative; z-index: 1;
    display: none; pointer-events: auto; flex-direction: column;
    margin: 12px var(--gutter-r) 0 var(--gutter-l); padding: 8px 0 12px;
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    background: rgba(5, 7, 15, 0.94);   /* near-opaque night; no blur surface over the live canvas */
  }
  .hd__mobile.open { display: flex; }
  .hd__mobile a { padding: 12px 16px; font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink); }
  .hd__mobile a[aria-current] { color: var(--alpenglow); }
  @media (max-width: 760px) {
    .hd::before { height: 116px; background: linear-gradient(180deg, rgb(var(--band)) 0%, rgb(var(--band)) 56%, rgb(var(--band) / 0.5) 76%, rgb(var(--band) / 0) 100%); }
    .hd::after { height: 65px; }
    .hd__nav { display: none; }
    .hd__menu { display: inline-flex; }
    .hd__inner { padding-top: 16px; }
  }
  /* landscape phones: a shallower band, so the header doesn't take a third of the view */
  @media (max-height: 500px) and (orientation: landscape) {
    .hd::before { height: 84px; background: linear-gradient(180deg, rgb(var(--band)) 0%, rgb(var(--band)) 62%, rgb(var(--band) / 0.5) 82%, rgb(var(--band) / 0) 100%); }
    .hd::after { height: 52px; }
    .hd__inner { padding-top: 14px; }
  }
  /* forced colours (high contrast): gradients drop out, so the band becomes a solid system background */
  @media (forced-colors: active) { .hd::before { background: Canvas; } }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-btn'), nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function () { var open = nav.classList.toggle('open'); btn.setAttribute('aria-expanded', String(open)); });
    nav.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && nav.classList.contains('open')) { nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); btn.focus(); }
    });
    // keyboard focus leaving the open menu closes it, so it never covers what focus moves on to
    nav.addEventListener('focusout', function (e) {
      if (nav.classList.contains('open') && !nav.contains(e.relatedTarget) && e.relatedTarget !== btn) { nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
    });
    document.addEventListener('click', function (e) {
      if (nav.classList.contains('open') && !nav.contains(e.target) && !btn.contains(e.target)) { nav.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
    });
  })();
</script>
