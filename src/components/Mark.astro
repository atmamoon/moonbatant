---
// Brand mark — "Ridgemoon": a full moon with the summit bitten out of its
// base in negative space (the header behind shows through the notch).
// Same geometry as /favicon.svg. Tinted via currentColor (gold by default).
interface Props { size?: number; }
const { size = 30 } = Astro.props;
---
<span class="mb-mark" style={`width:${size}px;height:${size}px;`} aria-hidden="true">
  <svg viewBox="0 0 32 32" width={size} height={size}>
    <path d="M6.7 29.4 A15 15 0 1 1 25.3 29.4 L16 14.9 Z" fill="currentColor"></path>
  </svg>
</span>
<style>
  .mb-mark { display: inline-flex; color: var(--accent-2); }
</style>
