---
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/#about', label: 'About' },
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Home">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M16.5 17a7 7 0 1 1 0-10 5.4 5.4 0 1 0 0 10Z" fill="var(--accent)"></path>
      </svg>
      <span>moonbatant</span>
    </a>

    <nav class="nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      <button id="menu-btn" class="menu-btn" aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .brand:hover { color: var(--text); }
  .nav {
    display: flex;
    gap: 28px;
  }
  .nav a {
    color: var(--text-soft);
    font-size: 0.92rem;
    font-weight: 500;
  }
  .nav a:hover { color: var(--text); }
  .header-actions { display: flex; align-items: center; gap: 10px; }
  .menu-btn {
    display: none;
    background: none;
    border: none;
    color: var(--text-soft);
    cursor: pointer;
    padding: 6px;
  }
  .mobile-nav {
    display: none;
    flex-direction: column;
    padding: 8px 24px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .mobile-nav.open { display: flex; }
  .mobile-nav a {
    padding: 10px 0;
    color: var(--text-soft);
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav a:last-child { border-bottom: none; }

  @media (max-width: 760px) {
    .nav { display: none; }
    .menu-btn { display: inline-flex; }
  }
</style>

<script is:inline>
  const btn = document.getElementById('menu-btn');
  const mobileNav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => mobileNav?.classList.toggle('open'));
  mobileNav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => mobileNav.classList.remove('open'))
  );
</script>
