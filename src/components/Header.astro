---
import Mark from './Mark.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/#about', label: 'About' },
  { href: '/#writing', label: 'Writing' },
];
---

<header class="kit-header-bar mb-header">
  <div class="mb-header__inner">
    <a href="/" class="mb-brand" aria-label="moonbatant — home">
      <Mark size={26} />
      <span class="mb-brand__word">moonbatant<span class="mb-brand__dot">.</span></span>
    </a>

    <nav class="mb-nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <button id="menu-btn" class="mb-menu-btn" aria-label="Menu" aria-expanded="false">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"></path></svg>
    </button>
  </div>

  <nav id="mobile-nav" class="mb-mobile-nav">
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
</header>

<style>
  .mb-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .mb-header__inner {
    margin: 0 auto;
    max-width: var(--maxw-wide);
    padding: 14px var(--gutter);
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .mb-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }
  .mb-brand__word {
    font-family: var(--font-serif);
    font-weight: var(--w-semibold);
    font-size: 1.15rem;
    color: var(--text);
    letter-spacing: -0.01em;
  }
  .mb-brand__dot { color: var(--accent); }

  .mb-nav {
    display: flex;
    gap: 22px;
    margin-left: auto;
    align-items: center;
  }
  .mb-nav a {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--text-soft);
  }
  .mb-nav a:hover { color: var(--link-hover); }

  .mb-menu-btn {
    display: none;
    margin-left: auto;
    background: none;
    border: none;
    color: var(--text-soft);
    cursor: pointer;
    padding: 6px;
  }
  .mb-mobile-nav {
    display: none;
    flex-direction: column;
    padding: 6px var(--gutter) 16px;
  }
  .mb-mobile-nav.open { display: flex; }
  .mb-mobile-nav a {
    padding: 11px 0;
    color: var(--text-soft);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 760px) {
    .mb-nav { display: none; }
    .mb-menu-btn { display: inline-flex; }
  }
</style>

<script is:inline>
  (function () {
    // frost the header once content scrolls underneath it — on EVERY page
    // (rAF-throttled; the setTimeout fallback covers render-suspended contexts)
    const bar = document.querySelector('.kit-header-bar');
    if (bar) {
      let queued = false;
      const apply = () => { queued = false; bar.classList.toggle('scrolled', window.scrollY > 40); };
      window.addEventListener('scroll', () => {
        if (!queued) { queued = true; requestAnimationFrame(apply); setTimeout(apply, 120); }
      }, { passive: true });
      apply();
    }
    const btn = document.getElementById('menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    if (!btn || !mobileNav) return;
    btn.addEventListener('click', () => {
      const open = mobileNav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    mobileNav.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => mobileNav.classList.remove('open'))
    );
  })();
</script>
