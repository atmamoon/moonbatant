---
import Icon from './Icon.astro';
// Square icon-only button/link. Always pass an accessible label.
interface Props { icon: string; label: string; href?: string; target?: string; rel?: string; }
const { icon, label, href, target, rel } = Astro.props;
const Tag = href ? 'a' : 'button';
const extra = href ? { href, target, rel } : { type: 'button' };
---
<Tag class="mb-iconbtn" aria-label={label} title={label} {...extra}>
  <Icon name={icon} size={18} />
</Tag>
<style>
  .mb-iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--glass-border);
    color: var(--text);
    cursor: pointer;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }
  .mb-iconbtn:hover { transform: var(--lift); color: var(--accent); background: rgba(255, 255, 255, 0.1); }
  .mb-iconbtn:active { transform: var(--press); }
</style>
