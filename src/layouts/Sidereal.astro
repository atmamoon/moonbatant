---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/standard-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/sidereal/tokens.css';
import '../styles/sidereal/base.css';
import Header from '../components/sidereal/Header.astro';
import Stage from '../components/sidereal/Stage.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../consts';

interface Props { title?: string; description?: string; mode?: 'clock' | 'night'; }
const { title, description, mode = 'clock' } = Astro.props;
const pageTitle = title ? `${title} — Mamoon Mondal` : SITE.title;
const pageDesc = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
---
<!doctype html>
<html lang="en" data-theme="dark" data-mode={mode} data-phase={mode === 'night' ? 'night' : 'golden'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#05070f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.jpg', SITE.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mamoon Mondal, AI Product Manager, set over a mountain range in evening light." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.jpg', SITE.url).href} />
    {/* crossorigin matches fetch()'s CORS mode, so the browser reuses the preload instead of downloading the stars twice */}
    <link rel="preload" as="fetch" href="/sidereal/stars.bin" crossorigin="anonymous" />
    <link rel="preload" as="image" href="/sidereal/range.webp" media="(min-width: 900px) and (pointer: fine)" />
    <link rel="preload" as="image" href="/sidereal/range-2k.webp" media="(max-width: 899px), (pointer: coarse)" />
    <noscript>
      <style is:inline>
        /* without JavaScript the scene can't run: the night still, read in night ink */
        html[data-phase] { --ink: #eaf0fb !important; --ink-2: rgba(234, 240, 251, 0.78) !important; --ink-3: rgba(234, 240, 251, 0.7) !important; --ink-4: rgba(234, 240, 251, 0.56) !important; }
        .stage__poster { background: linear-gradient(180deg, #05070f 0%, #0b1226 60%, #131a33 100%) !important; }
        .stage__poster::after { background-image: url('/sidereal/poster-night.webp') !important; }
        /* no script, no menu button: on phones the nav itself shows, in two rows, over a taller band */
        .hd__menu { display: none !important; }
        @media (max-width: 760px) {
          :root { --head-offset: 160px !important; }
          .hd__inner { flex-wrap: wrap !important; row-gap: 6px !important; }
          .hd__nav { display: flex !important; flex-wrap: wrap !important; width: 100% !important; margin-left: 0 !important; gap: 2px 16px !important; }
          .hd::before { height: 190px !important; background: linear-gradient(180deg, rgb(var(--band)) 0%, rgb(var(--band)) 76%, rgb(var(--band) / 0) 100%) !important; }
        }
      </style>
    </noscript>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to content</a>
    <Stage mode={mode} />
    <Header />
    <main id="top" class="above" tabindex="-1">
      <slot />
    </main>
    <script is:inline>
      // ?og=1 → a clean frame for social thumbnails (title + range only)
      if (new URLSearchParams(location.search).get('og') === '1') document.documentElement.classList.add('og');
    </script>
    <style>
      .skip-link { position: fixed; top: -60px; left: 16px; z-index: 100; padding: 10px 16px; background: var(--ink); color: #0b0f1c; font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; transition: top 0.2s ease; }
      .skip-link:focus-visible { top: 12px; }
    </style>
  </body>
</html>
